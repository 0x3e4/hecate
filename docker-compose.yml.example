services:
  backend:
    image: ghcr.io/0x3e4/hecate-backend:latest
    restart: unless-stopped
    env_file: ".env"
    ports:
      - "8000:8000"
    networks:
      - default
      - db
    depends_on:
      mongo:
        condition: service_healthy
      opensearch:
        condition: service_healthy
    # Custom CA
    # volumes:
    #   - ./certs/corporate-ca.pem:/etc/ssl/custom-ca.pem:ro

  frontend:
    image: ghcr.io/0x3e4/hecate-frontend:latest
    restart: unless-stopped
    env_file: ".env"
    ports:
      - "4173:4173"
    depends_on:
      backend:
        condition: service_started

  mongo:
    image: mongo:8
    restart: unless-stopped
    environment:
      MONGO_INITDB_ROOT_USERNAME: ${MONGO_USERNAME}
      MONGO_INITDB_ROOT_PASSWORD: ${MONGO_PASSWORD}
    deploy:
      resources:
        limits:
          memory: 2G
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')", "--quiet"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
    volumes:
      - mongo-data:/data/db
    networks:
      - db

  scanner:
    image: ghcr.io/0x3e4/hecate-scanner:latest
    restart: unless-stopped
    env_file: ".env"
    # The grype vulnerability DB (~3 GB) lives on the persistent `grype-db`
    # volume below, so it is not re-downloaded on every restart and does not
    # compete with scan workspaces for tmpfs space. Set here (not in .env) so it
    # always points at the mounted volume.
    environment:
      GRYPE_DB_CACHE_DIR: /grype-db
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp:size=10G
      - /root:size=50M
    cap_drop:
      - ALL
    deploy:
      resources:
        limits:
          memory: 12G
          cpus: "4"
        reservations:
          cpus: "1"
    # A named volume is writable even with read_only: true above.
    volumes:
      - grype-db:/grype-db                                      # persistent grype DB cache
    #   - ./certs/corporate-ca.pem:/etc/ssl/custom-ca.pem:ro    # custom CA (optional)

  # Documentation site (optional): docker compose --profile docs up -d docs
  # Static nginx, nothing on it loads from elsewhere. To build it yourself:
  # docker build -f docs/Dockerfile --build-arg DOCS_SITE_URL=https://docs.example.com/ -t ghcr.io/0x3e4/hecate-docs:latest .
  docs:
    image: ghcr.io/0x3e4/hecate-docs:latest
    restart: unless-stopped
    profiles: [docs]
    read_only: true
    tmpfs:
      - /var/cache/nginx
      - /var/run
      - /tmp
    cap_drop:
      - ALL
    cap_add:            # nginx switches to its own user at start
      - CHOWN
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1/"]
      interval: 30s
      timeout: 3s
    ports:
      - "127.0.0.1:8001:80"   # 8000 is the backend

  apprise:
    image: caronc/apprise:latest
    restart: unless-stopped
    environment:
      - APPRISE_STATEFUL_MODE=simple
    volumes:
      - apprise-config:/config
    deploy:
      resources:
        limits:
          memory: 1G

  opensearch:
    image: opensearchproject/opensearch:3
    restart: unless-stopped
    environment:
      TZ: ${TZ:-UTC}
      discovery.type: single-node
      OPENSEARCH_INITIAL_ADMIN_PASSWORD: ${OPENSEARCH_PASSWORD}
      OPENSEARCH_USERNAME: ${OPENSEARCH_USERNAME}
      OPENSEARCH_PASSWORD: ${OPENSEARCH_PASSWORD}
      OPENSEARCH_JAVA_OPTS: ${OPENSEARCH_JAVA_OPTS}
    ulimits:
      memlock:
        soft: -1
        hard: -1
    healthcheck:
      test: ["CMD-SHELL", "curl -skf -u $${OPENSEARCH_USERNAME}:$${OPENSEARCH_PASSWORD} https://localhost:9200/_cluster/health -o /dev/null"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    volumes:
      - opensearch-data:/usr/share/opensearch/data
    networks:
      - db

networks:
  default:
  db:
    internal: true

volumes:
  mongo-data:
  opensearch-data:
  apprise-config:
  # Persists the grype vulnerability DB across scanner restarts.
  grype-db: